{
  "name": "riscv-vector",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "postCreateCommand": "./setup.sh || true",
  "customizations": {
    "vscode": {
      "extensions": [
        "andrewnolte.vscode-system-verilog",
        "ms-vscode.cpptools",
        "charliermarsh.ruff",
        "editorconfig.editorconfig",
        "surfer-project.surfer"
      ],
      "settings": {
        "verilog.languageServer.server": "verible-verilog-ls",
        "verilog.languageServer.path": "/usr/local/bin/verible-verilog-ls",
        "verilog.languageServer.args": [
          "--try_wrap_long_lines"
        ]
      }
    }
  }
}
