[tasks]
prove
prove_baud
cover

[options]
prove: mode prove
prove: depth 8
prove_baud: mode prove
prove_baud: depth 8
cover: mode cover
cover: depth 12

[engines]
prove: smtbmc z3
prove: abc pdr
prove_baud: smtbmc z3
prove_baud: abc pdr
cover: smtbmc z3

[script]
read -formal tick_gen_formal.v
prove_baud: chparam -set DIVISOR 1736 tick_gen_formal
prep -top tick_gen_formal

[files]
build/tick_gen_formal.v
