[tasks]
prove
cover

[options]
prove: mode prove
prove: depth 3
cover: mode cover
cover: depth 4

[engines]
prove: smtbmc z3
prove: abc pdr
cover: smtbmc z3

[script]
read -formal vec_mul_lane_formal.v
prep -top vec_mul_lane_formal
techmap t:$shiftx
setundef -anyconst
flatten
techmap
opt -fast
abc -script +strash;fraig;dch;map
opt -fast

[files]
build/vec_mul_lane_formal.v
