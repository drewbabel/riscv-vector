{
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "verilog.svFormat.formatter": "verible",
  "verilog.verilogFormat.formatter": "verible",
  "[systemverilog]": {
    "editor.defaultFormatter": "andrewnolte.vscode-system-verilog",
    "editor.formatOnSave": true,
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "editor.autoIndent": "full"
  },
  "[verilog]": {
    "editor.defaultFormatter": "andrewnolte.vscode-system-verilog",
    "editor.formatOnSave": true,
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "editor.autoIndent": "full"
  },
  "[c]": {
    "editor.defaultFormatter": "ms-vscode.cpptools",
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "editor.rulers": [
      80
    ]
  },
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "editor.rulers": [
      80
    ]
  },
  "C_Cpp.formatting": "clangFormat",
  "C_Cpp.clang_format_fallbackStyle": "{ BasedOnStyle: LLVM, IndentWidth: 4, ColumnLimit: 80 }",
  "C_Cpp.default.cStandard": "c11",
  "ruff.lineLength": 80,
  "verilog.languageServer.server": "verible-verilog-ls",
  "verilog.languageServer.path": "verible-verilog-ls",
  "verilog.lint.slang.enabled": false,
  "verilog.lint.iverilog.enabled": true,
  "verilog.lint.iverilog.path": "iverilog",
  "verilog.lint.iverilog.args": "-g2012 -y . -y rtl -y ../rtl -y ../../rtl -Y .v -Y .sv",
  "verilog.lint.iverilog.runAtFileLocation": true,
  "verilog.lint.verilator.enabled": true,
  "verilog.lint.verilator.path": "verilator",
  "verilog.lint.verilator.args": "-Wno-TIMESCALEMOD -y . -y rtl -y ../rtl -y ../../rtl +libext+.v+.sv",
  "verilog.lint.verilator.runAtFileLocation": true,
  "verilog.svFormat.verible.path": "verible-verilog-format",
  "verilog.verilogFormat.veribleFormatter.path": "verible-verilog-format",
  "editor.semanticHighlighting.enabled": true
}
