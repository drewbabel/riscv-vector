{
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "verilog.svFormat.formatter": "verible",
  "verilog.verilogFormat.formatter": "verible",
  "[systemverilog]": {
    "editor.defaultFormatter": "andrewnolte.vscode-system-verilog",
    "editor.formatOnSave": true,
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "editor.autoIndent": "full"
  },
  "[verilog]": {
    "editor.defaultFormatter": "andrewnolte.vscode-system-verilog",
    "editor.formatOnSave": true,
    "editor.tabSize": 2,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "editor.autoIndent": "full"
  },
  "[c]": {
    "editor.defaultFormatter": "ms-vscode.cpptools",
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "editor.rulers": [80]
  },
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "editor.rulers": [80]
  },
  "C_Cpp.formatting": "clangFormat",
  "C_Cpp.clang_format_fallbackStyle": "{ BasedOnStyle: LLVM, IndentWidth: 4, ColumnLimit: 80 }",
  "C_Cpp.default.cStandard": "c11",
  "ruff.lineLength": 80
}
