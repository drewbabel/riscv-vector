root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{sv,v}]
indent_size = 2

[*.{c,h}]
indent_size = 4
max_line_length = 80

[*.py]
indent_size = 4
max_line_length = 80

[{Makefile,*.mk}]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
